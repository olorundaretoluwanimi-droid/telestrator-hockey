 "vo": [
  {
   "id": "v02",
   "t": 0.5,
   "text": "Puck drops. Start the clock."
  },
  {
   "id": "v03",
   "t": 9.55,
   "text": "Three Beacons already on the crease."
  },
  {
   "id": "v04",
   "t": 12.85,
   "text": "Jude Kurtas. Ten seconds in."
  },
  {
   "id": "v01",
   "t": 17.8,
   "text": "UMass Boston 8, Plymouth State 5. Two clocks tell this story."
  },
  {
   "id": "v05",
   "t": 28.7,
   "text": "Same pair, roles swapped. Krivtsov takes it to the net."
  },
  {
   "id": "v06",
   "t": 33.6,
   "text": "Merryman. Then Repmann. 4–1 after the first."
  },
  {
   "id": "v07",
   "t": 41.2,
   "text": "Then it turned. Plymouth State scores twice in 15 seconds. 4–4."
  },
  {
   "id": "v08",
   "t": 52.5,
   "text": "Two minutes later, three on two. Krivtsov again."
  },
  {
   "id": "v09",
   "t": 59.8,
   "text": "Teply, from Merryman. 6–4."
  },
  {
   "id": "v11",
   "t": 71.7,
   "text": "One more power play. Thirteen seconds left in the second."
  },
  {
   "id": "v12",
   "t": 80.9,
   "text": "Five on four. Drummond low, Kurtas up top."
  },
  {
   "id": "v13",
   "t": 87.1,
   "text": "Kurtas, up top, finds Mortson at the far circle."
  },
  {
   "id": "v15",
   "t": 91.3,
   "text": "One-timer, on one knee. And Krivtsov is right in the goalie's eyes."
  },
  {
   "id": "v16",
   "t": 97.3,
   "text": "7.7 to spare."
  },
  {
   "id": "v17",
   "t": 103.2,
   "text": "From above: Mortson 34 feet out. Krivtsov screening in the slot."
  },
  {
   "id": "v18",
   "t": 112.0,
   "text": "10 seconds in. 7.7 left. 8 goals on 38 shots."
  },
  {
   "id": "v19",
   "t": 123.3,
   "text": "And, the team says, the head coach's 500th game."
  }
 ]
}